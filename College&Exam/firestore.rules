rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /exams/{examId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
  }
}
